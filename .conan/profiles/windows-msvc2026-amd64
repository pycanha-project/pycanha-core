[settings]
arch = x86_64
compiler = msvc
compiler.cppstd = 23
compiler.runtime = dynamic
compiler.version = 195
os = Windows

[tool_requires]
# spirv-tools (tool_requires when PYCANHA_OPTION_RAYTRACING is on) is built with
# Ninja, because conan's tool-require cmake may be older than 4.2, the first
# version that knows the "Visual Studio 18 2026" generator. This is scoped to
# spirv-tools only and is invisible to consumers: pycanha-core and the bindings
# keep using the Visual Studio generator.
spirv-tools/*: ninja/[>=1.11]

[conf]
spirv-tools/*:tools.cmake.cmaketoolchain:generator=Ninja
